# ==============================================================================
# SDN Online Examination Network — Environment Configuration Example
# Copy this file to .env to customize environment configurations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TCP Examination Server Settings
# ------------------------------------------------------------------------------
# In Windows local dev: 127.0.0.1
# In Mininet Ubuntu deployment: 10.0.0.1 (h1)
EXAM_SERVER_HOST=127.0.0.1
EXAM_SERVER_PORT=5000
EXAM_DURATION_SEC=300
QUESTIONS_PER_EXAM=5

# ------------------------------------------------------------------------------
# 2. FastAPI Gateway Settings (api/main.py)
# ------------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
DB_PATH=exam_records.db

# Administrative Authentication (Server-Side Session Security)
# Set your strong administrator password. Required to log into the Admin Dashboard.
ADMIN_PASSWORD=your_secure_admin_password_here
# Secret key for HMAC-SHA256 session cookie signing.
# If omitted, a random 256-bit secret is generated automatically at process startup.
SESSION_SECRET=your_random_session_secret_key_here
# Set to true only if deploying over HTTPS; false for local HTTP dev and Mininet VM
SESSION_COOKIE_SECURE=false

# Set to true if running with active OpenFlow controller in Mininet
SDN_ENABLED=false

# Automatically boot in-process TCP exam server (convenience option)
START_EXAM_SERVER=false

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. React Frontend Settings (frontend/.env)
# ------------------------------------------------------------------------------
# Note: Sensitive credentials must NEVER be placed in VITE_* variables.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ------------------------------------------------------------------------------
# 4. Pure Python OpenFlow 1.3 SDN Controller Settings (sdn/controller.py)
# ------------------------------------------------------------------------------
SDN_CONTROLLER_HOST=0.0.0.0
SDN_CONTROLLER_PORT=6653
LINK_CAPACITY_MBPS=10.0
CONGESTION_THRESHOLD_PERCENT=70.0
RECOVERY_THRESHOLD_PERCENT=35.0
