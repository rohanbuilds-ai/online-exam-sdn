# SDN Online Examination Gateway - Environment Configuration Example

# TCP Examination Server
EXAM_SERVER_HOST=127.0.0.1
EXAM_SERVER_PORT=5000

# FastAPI Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# SQLite Persistence Path
DB_PATH=exam_records.db

# Administrative Authentication (Server-Side)
ADMIN_PASSWORD=your_secure_admin_password_here
SESSION_SECRET=your_random_session_secret_key_here
SESSION_COOKIE_SECURE=false

# Live SDN Controller flag
SDN_ENABLED=false

# Automatically start in-process ExamServer for local dev convenience
START_EXAM_SERVER=false

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
